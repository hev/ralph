#!/usr/bin/env bash
#
# ralph - Run Claude in a loop (like Ralph Wiggum, the defaults are insane)
#
set -uo pipefail

VERSION="1.0.0"

# Defaults (insane mode - unlimited everything)
PROMPT_FILE="./prompt.md"
MAX_ITERATIONS=0
MAX_TIME=0
AGENT_DIR="./.agent"
COOLDOWN=1
VERBOSE=true
DRY_RUN=false

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
ralph v${VERSION} - Run Claude in a loop

Usage: ralph [OPTIONS]

Options:
  -h, --help              Show this help message
  -p, --prompt FILE       Path to prompt file (default: ./prompt.md)
  -n, --max-iterations N  Max loop iterations (default: 0 = unlimited)
  -t, --max-time SECONDS  Max total runtime in seconds (default: 0 = unlimited)
  -d, --agent-dir DIR     Scratchpad directory (default: ./.agent)
  -c, --cooldown SECONDS  Delay between iterations (default: 1)
  -q, --quiet             Disable verbose output
  --dry-run               Show what would run without executing

Examples:
  ralph                           # Run forever with defaults
  ralph -n 5                      # Run for 5 iterations
  ralph -t 3600                   # Run for 1 hour
  ralph -p ~/tasks/build.md       # Use custom prompt file
  ralph -n 10 -c 5                # 10 iterations, 5s cooldown

"I'm in danger!" - Ralph Wiggum
EOF
}

log() {
    echo -e "${BLUE}[ralph]${NC} $*"
}

log_verbose() {
    if [[ "$VERBOSE" == "true" ]]; then
        echo -e "${YELLOW}[ralph]${NC} $*"
    fi
}

log_error() {
    echo -e "${RED}[ralph]${NC} $*" >&2
}

log_success() {
    echo -e "${GREEN}[ralph]${NC} $*"
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        -p|--prompt)
            PROMPT_FILE="$2"
            shift 2
            ;;
        -n|--max-iterations)
            MAX_ITERATIONS="$2"
            shift 2
            ;;
        -t|--max-time)
            MAX_TIME="$2"
            shift 2
            ;;
        -d|--agent-dir)
            AGENT_DIR="$2"
            shift 2
            ;;
        -c|--cooldown)
            COOLDOWN="$2"
            shift 2
            ;;
        -q|--quiet)
            VERBOSE=false
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        *)
            log_error "Unknown option: $1"
            usage
            exit 1
            ;;
    esac
done

# Validate prompt file exists
if [[ ! -f "$PROMPT_FILE" ]]; then
    log_error "Prompt file not found: $PROMPT_FILE"
    exit 1
fi

# Create agent directory if missing
if [[ ! -d "$AGENT_DIR" ]]; then
    log "Creating agent directory: $AGENT_DIR"
    mkdir -p "$AGENT_DIR"
fi

# Build full prompt
USER_PROMPT=$(cat "$PROMPT_FILE")
SCRATCHPAD_INSTRUCTIONS="

Use the ${AGENT_DIR} directory as a scratchpad for your work. Keep track of your current status in ${AGENT_DIR}/TODO.md using checkboxes (- [ ] for pending, - [x] for done). Check off items when completed. Only work on a single item at a time and end your session when complete. Make a commit and push your changes after every single file edit."

FULL_PROMPT="${USER_PROMPT}${SCRATCHPAD_INSTRUCTIONS}"

# Show configuration
log "Starting Ralph loop..."
log_verbose "Prompt file: $PROMPT_FILE"
log_verbose "Max iterations: ${MAX_ITERATIONS:-unlimited}"
log_verbose "Max time: ${MAX_TIME:-unlimited}s"
log_verbose "Agent dir: $AGENT_DIR"
log_verbose "Cooldown: ${COOLDOWN}s"

if [[ "$DRY_RUN" == "true" ]]; then
    log "Dry run mode - would execute:"
    echo "claude --dangerously-skip-permissions --print -p \"\$FULL_PROMPT\""
    echo ""
    echo "Full prompt:"
    echo "---"
    echo "$FULL_PROMPT"
    echo "---"
    exit 0
fi

# Track state
START_TIME=$(date +%s)
ITERATION=0
EXIT_REASON="unknown"

# Clean shutdown handler
cleanup() {
    EXIT_REASON="interrupted"
    echo ""
    log "Shutting down..."
    print_summary
    exit 0
}

print_summary() {
    ELAPSED=$(($(date +%s) - START_TIME))
    echo ""
    log_success "=== Ralph Summary ==="
    log_success "Iterations completed: $ITERATION"
    log_success "Total time: ${ELAPSED}s"
    log_success "Exit reason: $EXIT_REASON"
}

trap cleanup SIGINT SIGTERM

# Main loop
while true; do
    ITERATION=$((ITERATION + 1))

    # Check iteration limit
    if [[ $MAX_ITERATIONS -gt 0 && $ITERATION -gt $MAX_ITERATIONS ]]; then
        EXIT_REASON="max iterations reached"
        break
    fi

    # Check time limit
    ELAPSED=$(($(date +%s) - START_TIME))
    if [[ $MAX_TIME -gt 0 && $ELAPSED -ge $MAX_TIME ]]; then
        EXIT_REASON="max time reached"
        break
    fi

    log "=== Iteration $ITERATION ==="
    log "Running claude (this may take a moment)..."

    # Run claude with streaming JSON output, format with jq
    # Use process substitution to preserve exit code
    exit_code=0
    while IFS= read -r line; do
        # Parse and format JSON for readability
        msg_type=$(echo "$line" | jq -r '.type // empty' 2>/dev/null)

        case "$msg_type" in
            user)
                echo -e "${BLUE}━━━ USER ━━━${NC}"
                echo "$line" | jq -r '.message.content[]? | if .type == "text" then .text elif .type == "tool_result" then "Tool Result: \(.content // .output // "done")" else empty end' 2>/dev/null
                ;;
            assistant)
                echo -e "${GREEN}━━━ ASSISTANT ━━━${NC}"
                # Show text content
                echo "$line" | jq -r '.message.content[]? | select(.type == "text") | .text' 2>/dev/null
                # Show tool calls
                echo "$line" | jq -r '.message.content[]? | select(.type == "tool_use") | "\u001b[33m[TOOL: \(.name)]\u001b[0m\n\(.input | tostring | .[0:500])"' 2>/dev/null
                ;;
            result)
                echo -e "${YELLOW}━━━ RESULT ━━━${NC}"
                echo "$line" | jq -r '.subtype // empty' 2>/dev/null
                echo "$line" | jq -r 'if .result then (.result | .[0:1000]) else empty end' 2>/dev/null
                ;;
            system)
                echo -e "${RED}━━━ SYSTEM ━━━${NC}"
                echo "$line" | jq -r '.message // .subtype // empty' 2>/dev/null
                ;;
            *)
                # Show other message types raw but compact
                if [[ -n "$line" ]]; then
                    echo "$line" | jq -c '.' 2>/dev/null || echo "$line"
                fi
                ;;
        esac
    done < <(claude --dangerously-skip-permissions --print --verbose --output-format stream-json -p "$FULL_PROMPT" 2>&1) || exit_code=$?

    if [[ $exit_code -ne 0 ]]; then
        log_error "Claude exited with error (code $exit_code), continuing to next iteration..."
    else
        log_success "Iteration $ITERATION complete"
    fi

    log_verbose "Sleeping for ${COOLDOWN}s..."
    sleep "$COOLDOWN"
done

EXIT_REASON="${EXIT_REASON}"
print_summary
